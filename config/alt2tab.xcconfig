// alt2tab fork settings. Included as the last line of debug.xcconfig and release.xcconfig (never test-*.xcconfig)
// so it comes after upstream's own SWIFT_ACTIVE_COMPILATION_CONDITIONS and $(inherited) keeps DEBUG.

// ALT2TAB: fork behavior (no upstream Sparkle feed, AppCenter, license API, feedback backend)
// ALT2TAB_FORCE_PRO: LicenseManager.computeState() returns .pro
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) ALT2TAB ALT2TAB_FORCE_PRO

// Fail-safes so no Alt²Tab build can reach upstream's commercial infrastructure even if a code guard is lost in a merge.
// Endpoints derives every upstream URL (website, appcast, support, checkout, account, license API, feedback API) from these.
DOMAIN = github.com/vingt-douze/alt2tab
API_DOMAIN = alt2tab.invalid // RFC 2606 reserved TLD: never resolves
APPCENTER_SECRET = // empty: AppCenter refuses to start Crashes without a secret; overrides any local.xcconfig value
SPARKLE_PUBLIC_ED_KEY = // empty: no upstream key in the bundle; Sparkle treats an empty SUPublicEDKey as invalid and refuses to start, so a merge that re-creates the updater fails closed

// Separate identity from upstream AltTab so macOS (TCC permissions, UserDefaults, LaunchServices) treats the fork as its own app.
PRODUCT_NAME = Alt2Tab
PRODUCT_BUNDLE_IDENTIFIER = com.vingt-douze.alt2tab
ALT2TAB_DISPLAY_NAME = Alt²Tab // CFBundleDisplayName; PRODUCT_NAME stays ASCII for the .app/executable name
ASSETCATALOG_COMPILER_APPICON_NAME = app // resources/icons/app/app.icon (Icon Composer); actool emits Assets.car + a flattened app.icns (macOS < 26) and sets CFBundleIconFile/CFBundleIconName = app in the merged Info.plist
EXCLUDED_SOURCE_FILE_NAMES = menubar-2.pdf // MenubarIconPreference.colored is compiled out in the fork; keep the upstream asset out of the bundle

// Release signing: overrides release.xcconfig's hard-coded upstream Developer ID; Debug keeps "Local Self-Signed".
CODE_SIGN_IDENTITY[config=Release] = Developer ID Application
TEAM_ID = JFQXWZ2TMK // pbxproj: DEVELOPMENT_TEAM = ${TEAM_ID}; required with a generic identity
// Tracked so a clean clone builds a versioned app; upstream injects it from semantic-release via gitignored local.xcconfig.
CURRENT_PROJECT_VERSION = 1.1.0
